<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="sharp_array_joint" type="fixed">
        <parent link="base_link"/>
        <child link="sharp_array_link"/>
        <origin xyz="0.0 0.0 0.0462" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="sharp_array_link">
        <visual>
            <geometry>
                <cylinder radius="${radio_base}" length="0.0128"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${radio_base}" length="0.0128"/>
            </geometry>
        </collision>
    </link>

    <gazebo reference="sharp_array_link">
        <sensor name="sharp" type="ray">
            <pose> 0 0 0 0 0 0 </pose> <!-- Origen de sensor -->
            <visualize> true </visualize> <!-- Visualizacion de sensor -->
            <update_rate> 10 </update_rate> <!-- 10 Hz -->
            <ray> <!-- Parametros de sensor virtual -->
                <scan>
                    <horizontal>
                        <samples>9</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>0.8</max>
                </range>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <namespace>distance</namespace>
                    <argument>~/out:=sharp_scan</argument>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>sharp_array_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>